<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks>$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<EnableWindowsTargeting Condition="$(TargetFrameworks.Contains('windows'))">true</EnableWindowsTargeting>
    <UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(OS)' != 'Windows_NT'">
		<!-- Disables extraction and build of WinUI/Windows resources when build at Mac/Linux -->
		<EnableCoreMrtTooling>false</EnableCoreMrtTooling>
	</PropertyGroup>

	<PropertyGroup Condition="'$(IsOfficialBuild)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<!-- NuGet Metadata -->
	<PropertyGroup>
		<PackageId>libpjsua2maui</PackageId>
		<Title>libpjsua2maui</Title>
		<Version>2.17.0.3</Version>
		<Authors>Weslley Murdock</Authors>
		<Company>Remote Code Hub</Company>
		<Product>libpjsua2maui</Product>
		<Description>
PJSIP bindings for .NET MAUI using version 2.17 with openh264, openssl, opus,
and bcg729.
The builds of native libraries targets iOS devices (arm64), iOS simulators (arm64, x86_64),
android devices (arm64-v8a, armeabi-v7a) and android simulators (x86, x86_64),
also MacCatalyst (arm64, x86_64) and Windows (x64, ARM64) as well.
		</Description>
		<PackageReleaseNotes>
- 🐞 BugFix: apple namespaces werent working
- 🐞 BugFix: native libs on maccatalyst arm64 now use the correct binaries for the abi
- 🧩 Improvement: Updated docs to include Windows and MacCatalyst support
- 🧩 Improvement: Unified projects into a new libpjsua2maui.csproj for packaging
		</PackageReleaseNotes>
		<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<Copyright>Copyright ©2026 Remote Code Hub</Copyright>
		<PackageTags>sip;voip;pjsip;pj;pjlib;pjsua;maui;native;pjsua2;android;ios;windows;maccatalyst;net</PackageTags>
		<PackageProjectUrl>http://github.com/remotecodehub/libpjsua2maui</PackageProjectUrl>
		<RepositoryUrl>https://github.com/remotecodehub/libpjsua2maui</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		
		<PackageIcon>icon.png</PackageIcon>
		<PackageIconUrl>https://raw.githubusercontent.com/remotecodehub/libpjsua2maui/main/src/icon.png</PackageIconUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.101" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
	</ItemGroup>

	<ItemGroup>
		<!-- Arquivos de raiz (Sem barra inicial no PackagePath) -->
		<None Include="../../icon.png" Pack="true" PackagePath="icon.png" />
		<None Include="../../LICENSE.md" Pack="true" PackagePath="LICENSE.md" />
		<None Include="../../README.md" Pack="true" PackagePath="README.md" />
		<None Include="../../docs/README.md" Pack="true" PackagePath="docs/README.md" />

		<None Include="build/libpjsua2maui.targets" Pack="true" PackagePath="build/" />
 
		<None Include="Platforms/Android/runtimes/android-arm/native/**/*.*" Pack="true" PackagePath="runtimes/android-arm/native/" />
		<None Include="Platforms/Android/runtimes/android-arm64/native/**/*.*" Pack="true" PackagePath="runtimes/android-arm64/native/" />
		<None Include="Platforms/Android/runtimes/android-x86/native/**/*.*" Pack="true" PackagePath="runtimes/android-x86/native/" />
		<None Include="Platforms/Android/runtimes/android-x86_64/native/**/*.*" Pack="true" PackagePath="runtimes/android-x86_64/native/" />

		<None Include="Platforms/iOS/runtimes/ios-arm64/native/**/*.*" Pack="true" PackagePath="runtimes/ios-arm64/native/" />
		<None Include="Platforms/iOS/runtimes/iossimulator-arm64/native/**/*.*" Pack="true" PackagePath="runtimes/iossimulator-arm64/native/" />
		<None Include="Platforms/iOS/runtimes/iossimulator-x64/native/**/*.*" Pack="true" PackagePath="runtimes/iossimulator-x64/native/" />

		<None Include="Platforms/MacCatalyst/runtimes/maccatalyst-arm64/native/**/*.*" Pack="true" PackagePath="runtimes/maccatalyst-arm64/native/" />
		<None Include="Platforms/MacCatalyst/runtimes/maccatalyst-x64/native/**/*.*" Pack="true" PackagePath="runtimes/maccatalyst-x64/native/" />

		<None Include="Platforms/Windows/runtimes/win-arm64/native/**/*.*" Pack="true" PackagePath="runtimes/win-arm64/native/" />
		<None Include="Platforms/Windows/runtimes/win-x64/native/**/*.*" Pack="true" PackagePath="runtimes/win-x64/native/" />

		<!-- Assets Java -->
		<None Include="Platforms/Android/org/pjsip/*.java" Pack="true" PackagePath="contentFiles/any/android/org/pjsip/" />

		<!-- Licenças de Terceiros -->
		<None Include="../third_party/bcg729/LICENSE.txt" Pack="true" PackagePath="third_party_notice/bcg729/" />
		<None Include="../third_party/openh264/LICENSE.md" Pack="true" PackagePath="third_party_notice/openh264/" />
		<None Include="../third_party/openssl/LICENSE.txt" Pack="true" PackagePath="third_party_notice/openssl/" />
		<None Include="../third_party/opus/LICENSE.md" Pack="true" PackagePath="third_party_notice/opus/" />
		<None Include="../third_party/pjsip/LICENSE.md" Pack="true" PackagePath="third_party_notice/pjsip/" />
	</ItemGroup>

</Project>